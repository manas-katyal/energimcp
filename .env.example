# Nothing here is required. Energi Data Service is open public data: no API key,
# no account, no registration. These only exist to move things around.

# Where the catalogue cache lives. In stdio mode it defaults to ~/.energimcp.
# CACHE_DIR=./cache

# Point at a different host, e.g. the staging site test01.energidataservice.dk.
# EDS_API_BASE=https://api.energidataservice.dk

# --- Hosted deployment only ---
# PORT=8080
# BASE_URL=https://energi.example.com

# --- Tuning ---
# How long a dataset query may be served from cache when the dataset does not
# declare an update frequency. Datasets that do declare one use that instead.
# CACHE_TTL_SECONDS=300
# CATALOG_TTL_SECONDS=86400
# Minimum spacing between outbound calls, so a burst of tool calls trickles.
# MIN_REQUEST_INTERVAL_MS=300
# Row caps. These protect the model's context, not the API.
# DEFAULT_LIMIT=200
# MAX_LIMIT=5000
